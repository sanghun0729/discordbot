# Discord 봇 토큰 (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# 애플리케이션(클라이언트) ID (Developer Portal > General Information > Application ID)
CLIENT_ID=your-application-id

# 슬래시 명령을 등록할 테스트 서버 ID. 개발 중에는 지정 권장(즉시 반영).
# 비워두면 전역 등록(반영까지 최대 1시간).
GUILD_ID=

# 로컬 ML 사이드카(STT/번역/TTS) 주소. 같은 서버면 기본값 사용.
ML_SERVICE_URL=http://127.0.0.1:8000
