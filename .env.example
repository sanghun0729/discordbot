# Discord 봇 토큰 (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# 애플리케이션(클라이언트) ID (Developer Portal > General Information > Application ID)
CLIENT_ID=your-application-id

# 슬래시 명령을 등록할 테스트 서버 ID. 개발 중에는 지정 권장(즉시 반영).
# 비워두면 전역 등록(반영까지 최대 1시간).
GUILD_ID=

# OpenAI API 키 (Whisper STT + GPT 번역)
OPENAI_API_KEY=sk-...

# (선택) 모델 오버라이드
# WHISPER_MODEL=whisper-1
# TRANSLATE_MODEL=gpt-4o-mini

# (선택) 화자의 입력 언어를 고정하면 STT 정확도가 올라간다 (ISO-639-1, 예: ko, en, ja).
# 비워두면 Whisper 가 자동 감지.
# SOURCE_LANG=
